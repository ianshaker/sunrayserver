# Пример переменных окружения. Значения не хранятся в репозитории:
# боевые ключи живут только в настройках Render.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram ---
TELEGRAM_TOKEN=
TELEGRAM_SETUP_SECRET=

# --- Google (расшифровка звонков, Gemini) ---
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Gmail: страница активации почты ---
GMAIL_SETUP_SECRET=

# --- Mango Office ---
MANGO_VPBX_API_KEY=
MANGO_VPBX_API_SALT=

# --- Push-уведомления ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Яндекс.Почта по IMAP (только чтение) ---
# Рубильник: пока false, модуль не подключается к почте вовсе.
YANDEX_IMAP_ENABLED=false
# Тень: читаем и сверяем, но ни карточек, ни сообщений в Telegram.
YANDEX_IMAP_SHADOW_MODE=true
YANDEX_IMAP_HOST=imap.ya.ru
YANDEX_IMAP_PORT=993
YANDEX_IMAP_SECURE=true
# Адрес ящика и пароль приложения задаёт владелец в Render. Сюда не вписывать.
YANDEX_IMAP_USER=
YANDEX_IMAP_PASSWORD=
YANDEX_IMAP_MAILBOX=INBOX
# Снятие этого флага останавливает модуль: он работает только на чтение.
YANDEX_IMAP_READ_ONLY=true
YANDEX_IMAP_POLL_INTERVAL_MS=60000
